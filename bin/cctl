#!/usr/bin/env bash
set -euo pipefail

SCRIPT_SOURCE=${BASH_SOURCE[0]}
if command -v readlink >/dev/null 2>&1; then
    SCRIPT_REAL=$(readlink -f -- "$SCRIPT_SOURCE" 2>/dev/null || printf '%s' "$SCRIPT_SOURCE")
else
    SCRIPT_REAL=$SCRIPT_SOURCE
fi
ROOT=$(cd -- "$(dirname -- "$SCRIPT_REAL")/.." && pwd)
REGISTRY="$ROOT/.cctl/entries"

fail() { printf 'cctl: %s\n' "$*" >&2; exit 1; }
note() { printf 'cctl: %s\n' "$*" >&2; }
usage() {
    cat <<'HELP'
Usage: cctl ls
       cctl add NAME SOURCE [TARGET] [PACKAGE...]
       cctl remove NAME
       cctl apply NAME... | --all
       cctl update NAME... | --all
       cctl restore archlinux|oh-my-zsh
       cctl hook NAME pre|post SCRIPT|--remove
       cctl push [MESSAGE]
       cctl pull
       cctl compact
       cctl install [--user|--system] [--copy]
       cctl uninstall [--user|--system] [--force]
       cctl cmp zsh

TARGET defaults to SOURCE and may start with ~/; SOURCE may be a file or directory.
Edit repository files to change a configuration, then run apply again.
HELP
}
valid_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
expand_target() {
    case $1 in
        '~') printf '%s' "$HOME" ;;
        '~/'*) printf '%s/%s' "$HOME" "${1#\~/}" ;;
        /*) printf '%s' "$1" ;;
        *) fail "target must be absolute or start with ~/: $1" ;;
    esac
}
find_entry() {
    local wanted=$1
    awk -F '|' -v wanted="$wanted" '$1 == wanted { print; found=1; exit } END { if (!found) exit 1 }' "$REGISTRY"
}
package_missing() {
    local package=$1
    pacman -Q -- "$package" >/dev/null 2>&1
}
check_dependencies() {
    local names=$1 package missing=()
    [ -n "$names" ] || return 0
    command -v pacman >/dev/null || return 0
    IFS=, read -r -a packages <<< "$names"
    for package in "${packages[@]}"; do
        [ -n "$package" ] || continue
        package_missing "$package" || missing+=("$package")
    done
    if [ "${#missing[@]}" -gt 0 ]; then
        note "missing packages: ${missing[*]}"
        note "install with: sudo pacman -S -- ${missing[*]} (or paru -S -- ${missing[*]} for AUR packages)"
        return 1
    fi
}
apply_patch_file() {
    local patchfile=$1 patchroot=$2
    patch --batch --forward --dry-run -d "$patchroot" -p0 < "$patchfile" >/dev/null || return 1
    patch --batch --forward -d "$patchroot" -p0 < "$patchfile" >/dev/null
}
directory_patch_root() {
    local patchfile=$1 dest=$2 first_path
    first_path=$(sed -n '/^--- / { s/^--- //; s/[[:space:]].*$//; p; q; }' "$patchfile")
    case $first_path in
        "$(basename -- "$dest")"/*) dirname -- "$dest" ;;
        *) printf '%s\n' "$dest" ;;
    esac
}
check_hook() {
    local path=$1
    [ -n "$path" ] || return 0
    case $path in
        /*|..|../*|*/../*|*/..) fail "unsafe hook path: $path" ;;
    esac
    [ -f "$ROOT/$path" ] || fail "hook missing: $ROOT/$path"
}
run_hook() {
    local phase=$1 path=$2 name=$3 source=$4 dest=$5
    [ -n "$path" ] || return 0
    note "running $phase hook for $name: $path"
    (cd -- "$ROOT" && bash "$path" "$name" "$source" "$dest")
}
apply_directory() {
    local name=$1 source=$2 dest=$3 secret=$4 patchfile patchroot secret_patch rc=0
    mkdir -p -- "$dest"
    cp -a -- "$source/." "$dest/" || return 1
    if [ "$rc" -eq 0 ]; then
        while IFS= read -r -d '' patchfile; do
            [ "$rc" -eq 0 ] || break
            patchroot=$(directory_patch_root "$patchfile" "$dest")
            apply_patch_file "$patchfile" "$patchroot" || rc=1
        done < <(find "$dest" -maxdepth 1 -type f -name '*.patch' -print0 | sort -z)
    fi
    if [ "$rc" -eq 0 ] && [ -n "$secret" ]; then
        if ! command -v sctl >/dev/null; then note "sctl is required for $name"; rc=1; fi
        secret_patch=$(mktemp)
        if [ "$rc" -eq 0 ]; then sctl get --output "$secret_patch" "$secret" || rc=1; fi
        if [ "$rc" -eq 0 ]; then
            patchroot=$(directory_patch_root "$secret_patch" "$dest")
            apply_patch_file "$secret_patch" "$patchroot" || rc=1
        fi
        rm -f -- "$secret_patch"
    fi
    if [ "$rc" -ne 0 ]; then
        note "failed to apply $name"
        return 1
    fi
}
apply_entry() {
    local name=$1 row source target packages pre_hook post_hook secret extra dest backup patchroot patchfile rc=0
    row=$(find_entry "$name") || fail "unknown configuration: $name"
    IFS='|' read -r name source target packages pre_hook post_hook secret extra <<< "$row"
    [ -z "${extra:-}" ] || fail "invalid registry entry: $name"
    source="$ROOT/$source"
    [ -e "$source" ] || fail "source missing: $source"
    check_hook "$pre_hook"
    check_hook "$post_hook"
    check_dependencies "$packages" || return 1
    dest=$(expand_target "$target")
    patchroot=$(dirname -- "$dest")
    mkdir -p -- "$patchroot"
    run_hook pre "$pre_hook" "$name" "$source" "$dest" || return 1
    if [ -d "$source" ]; then
        apply_directory "$name" "$source" "$dest" "$secret" || return 1
        run_hook post "$post_hook" "$name" "$source" "$dest" || { note "failed to apply $name (post hook)"; return 1; }
        note "applied $name -> $dest"
        return
    fi
    backup=$(mktemp -d)
    if [ -e "$dest" ]; then cp -a -- "$dest" "$backup/original"; fi
    # Keep user patches outside the source repository and reapply them after replacement.
    if [ -d "$dest" ]; then
        mkdir -p "$backup/patches"
        find "$dest" -maxdepth 1 -type f -name '*.patch' -exec cp -a -- '{}' "$backup/patches/" \;
    elif [ -f "$dest.patch" ]; then
        mkdir -p "$backup/patches"
        cp -a -- "$dest.patch" "$backup/patches/"
    fi
    rm -rf -- "$dest" || rc=1
    if [ "$rc" -eq 0 ]; then cp -a -- "$source" "$dest" || rc=1; fi
    if [ "$rc" -eq 0 ] && [ -d "$backup/patches" ]; then
        while IFS= read -r -d '' patchfile; do
            if [ -d "$source" ]; then patchroot=$(directory_patch_root "$patchfile" "$dest"); fi
            apply_patch_file "$patchfile" "$patchroot" || { rc=1; break; }
        done < <(find "$backup/patches" -maxdepth 1 -type f -name '*.patch' -print0 | sort -z)
    fi
    if [ "$rc" -eq 0 ] && [ -n "$secret" ]; then
        command -v sctl >/dev/null || { note "sctl is required for $name"; rc=1; }
        patchfile="$backup/secret.patch"
        if [ "$rc" -eq 0 ]; then sctl get --output "$patchfile" "$secret" || rc=1; fi
        if [ "$rc" -eq 0 ]; then
            if [ -d "$source" ]; then patchroot=$(directory_patch_root "$patchfile" "$dest"); fi
            apply_patch_file "$patchfile" "$patchroot" || rc=1
        fi
    fi
    if [ "$rc" -eq 0 ]; then run_hook post "$post_hook" "$name" "$source" "$dest" || rc=1; fi
    if [ "$rc" -ne 0 ]; then
        rm -rf -- "$dest"
        if [ -e "$backup/original" ]; then cp -a -- "$backup/original" "$dest"; fi
        rm -rf -- "$backup"
        note "failed to apply $name; previous configuration restored"
        return 1
    fi
    rm -rf -- "$backup"
    note "applied $name -> $dest"
}
cmd_add() {
    [ "$#" -ge 2 ] || fail 'add needs NAME SOURCE [TARGET] [PACKAGE...]'
    local name=$1 input=$2 target= package rel source_abs target_abs home_abs joined= existing_name existing_source existing_target rest
    shift 2
    valid_name "$name" || fail 'invalid configuration name'
    [ "$name" != vim ] || fail 'vim is a reserved configuration'
    [ -e "$input" ] || fail "source not found: $input"
    find_entry "$name" >/dev/null 2>&1 && fail "configuration already exists: $name"
    source_abs="$(cd -- "$(dirname -- "$input")" && pwd -P)/$(basename -- "$input")"
    case ${1:-} in
        /*|'~/'*) target=$1; shift ;;
        *)
            case $source_abs in
                "$ROOT"|"$ROOT"/*) fail 'source is in this repository; specify TARGET explicitly' ;;
            esac
            case $source_abs in
                "$HOME") target='~' ;;
                "$HOME"/*) target="~/${source_abs#"$HOME"/}" ;;
                *) target=$source_abs ;;
            esac
            ;;
    esac
    expand_target "$target" >/dev/null
    for package in "$@"; do valid_name "$package" || fail "invalid package name: $package"; done
    home_abs=$(realpath -m -- "$HOME")
    target_abs=$(realpath -m -- "$(expand_target "$target")")
    while IFS='|' read -r existing_name existing_source existing_target rest; do
        [ -n "$existing_name" ] || continue
        if [ "$(realpath -m -- "$(expand_target "$existing_target")")" = "$target_abs" ]; then
            fail "target already registered by $existing_name: $target"
        fi
    done < "$REGISTRY"
    case $target_abs in
        "$home_abs"/*)
            rel=${target_abs#"$home_abs"/}
            case $rel in */*) ;; *) rel="$name/$rel" ;; esac
            ;;
        /*) rel="$name/$(basename -- "$target_abs")" ;;
        *) fail "invalid target: $target" ;;
    esac
    [ "$target_abs" != "$home_abs" ] || fail 'refusing to register an entire HOME directory'
    [ ! -e "$ROOT/$rel" ] && [ ! -L "$ROOT/$rel" ] || fail "repository path already exists: $rel"
    mkdir -p -- "$(dirname -- "$ROOT/$rel")"
    cp -a -- "$input" "$ROOT/$rel"
    if [ "$#" -gt 0 ]; then joined=$(IFS=,; printf '%s' "$*"); fi
    printf '%s|%s|%s|%s|||\n' "$name" "$rel" "$target" "$joined" >> "$REGISTRY"
    note "added $name; review and commit repository changes"
}
cmd_hook() {
    [ "$#" -eq 3 ] || fail 'usage: cctl hook NAME pre|post SCRIPT|--remove'
    local name=$1 phase=$2 input=$3 row field path tmp
    valid_name "$name" || fail 'invalid configuration name'
    row=$(find_entry "$name") || fail "unknown configuration: $name"
    case $phase in pre) field=5 ;; post) field=6 ;; *) fail 'hook phase must be pre or post' ;; esac
    if [ "$input" = --remove ]; then
        path=
    else
        [ -f "$input" ] || fail "hook script not found: $input"
        path=".cctl/hooks/$name-$phase.sh"
        if [ "$(realpath -- "$input")" != "$(realpath -m -- "$ROOT/$path")" ]; then
            cp -- "$input" "$ROOT/$path"
        fi
    fi
    tmp=$(mktemp "$ROOT/.cctl/entries.XXXXXX")
    awk -F '|' -v OFS='|' -v name="$name" -v field="$field" -v path="$path" '
        NF != 7 { exit 1 }
        $1 == name { $field=path }
        { print $1,$2,$3,$4,$5,$6,$7 }
    ' "$REGISTRY" > "$tmp" || { rm -f -- "$tmp"; fail 'invalid registry format'; }
    mv -- "$tmp" "$REGISTRY"
    note "registered $phase hook for $name: ${path:-removed}"
}
cmd_remove() {
    [ "$#" -eq 1 ] || fail 'remove needs NAME'
    local name=$1 row source target packages pre_hook post_hook secret extra tmp
    [ "$name" != vim ] || fail 'vim is a reserved configuration'
    row=$(find_entry "$name") || fail "unknown configuration: $name"
    IFS='|' read -r name source target packages pre_hook post_hook secret extra <<< "$row"
    case $source in
        ''|'.'|/*|*'..'*) fail "unsafe source path in registry: $source" ;;
    esac
    if awk -F '|' -v name="$name" -v source="$source" '$1 != name && $2 == source { found=1 } END { exit !found }' "$REGISTRY"; then
        fail "source is shared by another configuration: $source"
    fi
    tmp=$(mktemp "$ROOT/.cctl/entries.XXXXXX")
    awk -F '|' -v name="$name" '$1 != name' "$REGISTRY" > "$tmp"
    mv -- "$tmp" "$REGISTRY"
    rm -rf -- "$ROOT/$source"
    note "removed $name from registry; deployed files were left in place"
}
require_clean_git() {
    git -C "$ROOT" diff --quiet && git -C "$ROOT" diff --cached --quiet && [ -z "$(git -C "$ROOT" ls-files --others --exclude-standard)" ] || fail 'working tree is not clean'
}
cmd_push() {
    git -C "$ROOT" add -A
    if ! git -C "$ROOT" diff --cached --quiet; then
        git -C "$ROOT" commit -m "${1:-Update configurations}"
    fi
    git -C "$ROOT" push origin "$(git -C "$ROOT" branch --show-current)"
}
cmd_pull() {
    require_clean_git
    local branch remote backup
    branch=$(git -C "$ROOT" branch --show-current)
    [ -n "$branch" ] || fail 'pull requires a branch'
    git -C "$ROOT" fetch origin "$branch"
    remote=FETCH_HEAD
    if git -C "$ROOT" merge-base --is-ancestor HEAD "$remote"; then
        git -C "$ROOT" merge --ff-only "$remote"
    elif git -C "$ROOT" merge-base --is-ancestor "$remote" HEAD; then
        note 'local branch is ahead of remote; nothing to pull'
    else
        backup="cctl-backup-$(date +%Y%m%d%H%M%S)"
        git -C "$ROOT" branch "$backup"
        git -C "$ROOT" reset --hard "$remote"
        note "remote history changed; previous local branch saved as $backup"
    fi
}
cmd_compact() {
    require_clean_git
    local branch old remote new
    branch=$(git -C "$ROOT" branch --show-current)
    [ -n "$branch" ] || fail 'compact requires a branch'
    git -C "$ROOT" fetch origin "$branch"
    remote=$(git -C "$ROOT" rev-parse FETCH_HEAD)
    old=$(git -C "$ROOT" rev-parse HEAD)
    [ "$old" = "$remote" ] || fail 'local and remote differ; pull or push first'
    new=$(git -C "$ROOT" commit-tree "$(git -C "$ROOT" rev-parse HEAD^{tree})" -m 'Compact configuration history')
    git -C "$ROOT" update-ref "refs/heads/$branch" "$new" "$old"
    git -C "$ROOT" reset --hard "$new" >/dev/null
    git -C "$ROOT" push --force-with-lease origin "$branch"
    note "compacted $branch to one commit"
}
cmd_install() {
    local scope=user copy=0 parent destination quoted_root
    local -a run=()
    while [ "$#" -gt 0 ]; do
        case $1 in
            --user) scope=user ;;
            --system) scope=system ;;
            --copy) copy=1 ;;
            --force) ;; # Replacing an existing launcher is the default.
            *) fail "unknown install option: $1" ;;
        esac
        shift
    done
    if [ "$scope" = user ]; then parent="$HOME/.local/bin"; else parent=/usr/local/bin; fi
    destination="$parent/cctl"
    if [ "$scope" = system ] && [ ! -w "$parent" ]; then run=(sudo); fi
    "${run[@]}" mkdir -p -- "$parent"
    if [ -e "$destination" ] || [ -L "$destination" ]; then
        "${run[@]}" rm -f -- "$destination"
    fi
    if [ "$copy" = 1 ]; then
        printf -v quoted_root '%q' "$ROOT"
        printf '#!/usr/bin/env bash\nCCTL_REPO=%s\n# cctl launcher for this repository\nexec "$CCTL_REPO/bin/cctl" "$@"\n' "$quoted_root" | "${run[@]}" tee "$destination" >/dev/null
        "${run[@]}" chmod 755 "$destination"
    else
        "${run[@]}" ln -s -- "$SCRIPT_REAL" "$destination"
    fi
    note "installed $destination"
    if [ "$scope" = user ] && [[ :$PATH: != *":$parent:"* ]]; then
        note "add $parent to PATH to invoke cctl directly"
    fi
}
cmd_uninstall() {
    local scope=user force=0 parent destination actual owned=0 quoted_root
    local -a run=()
    while [ "$#" -gt 0 ]; do
        case $1 in
            --user) scope=user ;;
            --system) scope=system ;;
            --force) force=1 ;;
            *) fail "unknown uninstall option: $1" ;;
        esac
        shift
    done
    if [ "$scope" = user ]; then parent="$HOME/.local/bin"; else parent=/usr/local/bin; fi
    destination="$parent/cctl"
    [ -e "$destination" ] || [ -L "$destination" ] || { note "not installed: $destination"; return; }
    if [ -L "$destination" ]; then
        actual=$(readlink -f -- "$destination" 2>/dev/null || true)
        [ "$actual" = "$SCRIPT_REAL" ] && owned=1
    else
        printf -v quoted_root '%q' "$ROOT"
    fi
    if [ -f "$destination" ] && [ ! -L "$destination" ] \
        && grep -Fqx '# cctl launcher for this repository' "$destination" 2>/dev/null \
        && grep -Fqx "CCTL_REPO=$quoted_root" "$destination" 2>/dev/null \
        && grep -Fqx 'exec "$CCTL_REPO/bin/cctl" "$@"' "$destination" 2>/dev/null; then
        owned=1
    fi
    [ "$owned" = 1 ] || [ "$force" = 1 ] || fail "refusing to remove an unrecognized launcher (use --force): $destination"
    if [ "$scope" = system ] && [ ! -w "$parent" ]; then run=(sudo); fi
    "${run[@]}" rm -f -- "$destination"
    note "removed $destination; repository files were kept"
}
cmd_complete() {
    [ "$#" -eq 1 ] && [ "$1" = zsh ] || fail 'only zsh completion is supported'
    cat <<'ZSH'
#compdef cctl
if ! (( $+functions[compdef] )); then
  autoload -Uz compinit
  compinit -i
fi
_cctl_names() {
  local -a names
  names=(${(f)"$(cctl ls 2>/dev/null | cut -f1)"})
  _describe -t names 'configuration' names
}
_cctl() {
  local -a commands
  commands=(
    'ls:list configurations'
    'add:add a configuration'
    'remove:remove a configuration'
    'apply:deploy configurations'
    'update:deploy configurations'
    'hook:register an apply hook'
    'restore:run a restore script'
    'push:commit and push changes'
    'pull:fetch repository changes'
    'compact:squash history and force push'
    'install:install cctl on PATH'
    'uninstall:remove installed launcher'
    'cmp:print shell completion code'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'cctl command' commands
    return
  fi
  case $words[2] in
    apply|update) _alternative 'configs:configuration:_cctl_names' 'all:all configurations:(--all)' ;;
    remove) _cctl_names ;;
    add) _arguments '1:name:' '2:source:_files' '3:optional target or package:_files' '*:package:' ;;
    hook) _arguments '1:configuration:_cctl_names' '2:phase:(pre post)' '3:script:_files' ;;
    restore) _values 'restore script' archlinux oh-my-zsh ;;
    push) _message 'commit message' ;;
    install) _arguments '--user[install to ~/.local/bin]' '--system[install to /usr/local/bin]' '--copy[install a launcher copy]' ;;
    uninstall) _arguments '--user[remove user launcher]' '--system[remove system launcher]' '--force[remove unrecognized launcher]' ;;
    cmp) _values 'shell' zsh ;;
  esac
}
compdef _cctl cctl
ZSH
}

command=${1:-help}; shift || true
case $command in
    ls|add|hook|remove|apply|update) [ -f "$REGISTRY" ] || fail "registry missing: $REGISTRY" ;;
esac
case $command in
    help|-h|--help) usage ;;
    ls) [ "$#" -eq 0 ] || fail 'ls takes no arguments'; awk -F '|' '{ printf "%s\t%s\n", $1, $3 }' "$REGISTRY" ;;
    add) cmd_add "$@" ;;
    hook) cmd_hook "$@" ;;
    remove) cmd_remove "$@" ;;
    restore)
        [ "$#" -eq 1 ] || fail 'restore needs one script name'
        valid_name "$1" || fail 'invalid restore script name'
        [ -f "$ROOT/.cctl/restore/$1.sh" ] || fail "unknown restore script: $1"
        [ -d "$ROOT/asset/$1" ] || fail "restore assets missing: $ROOT/asset/$1"
        bash "$ROOT/.cctl/restore/$1.sh" "$ROOT" "$ROOT/asset/$1"
        ;;
    apply|update)
        [ "$#" -gt 0 ] || fail 'apply needs NAME or --all'
        if [ "$1" = --all ]; then
            [ "$#" -eq 1 ] || fail '--all cannot be combined with names'
            result=0
            while IFS='|' read -r name _; do
                [ -n "$name" ] || continue
                apply_entry "$name" || result=1
            done < "$REGISTRY"
            exit "$result"
        else
            result=0
            for name in "$@"; do
                apply_entry "$name" || result=1
            done
            exit "$result"
        fi
        ;;
    push) [ "$#" -le 1 ] || fail 'push accepts one message'; cmd_push "${1:-}" ;;
    pull) [ "$#" -eq 0 ] || fail 'pull takes no arguments'; cmd_pull ;;
    compact) [ "$#" -eq 0 ] || fail 'compact takes no arguments'; cmd_compact ;;
    install) cmd_install "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    cmp) cmd_complete "$@" ;;
    *) fail "unknown command: $command" ;;
esac
